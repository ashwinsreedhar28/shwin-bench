   "gold_patch": "diff --git a/pagedserve/server/app.py b/pagedserve/server/app.py\nindex 147f80a..6fab6af 100644\n--- a/pagedserve/server/app.py\n+++ b/pagedserve/server/app.py\n@@ -153,6 +155,9 @@ def create_app(async_engine: \"AsyncLLMEngine | AsyncEngineCoreClient\", model_nam\n             prompt_ids = tokenizer().encode(p)\n         elif p and all(isinstance(x, int) for x in p):\n             prompt_ids = list(p)\n+            if max(prompt_ids) >= async_engine.vocab_size or min(prompt_ids) < 0:\n+                raise HTTPException(400, f\"prompt token id out of vocabulary \"\n+                                         f\"(vocab_size {async_engine.vocab_size})\")\n         else:\n             raise HTTPException(400, \"prompt must be a string or a list of token ids\")\n         rid = new_id(\"cmpl-\")\ndiff --git a/pagedserve/server/async_engine.py b/pagedserve/server/async_engine.py\nindex d8d8133..ff038dd 100644\n--- a/pagedserve/server/async_engine.py\n+++ b/pagedserve/server/async_engine.py\n@@ -79,6 +79,10 @@ class AsyncLLMEngine:\n         self._snapshot = self._take_snapshot()\n \n     # ---- lifecycle (call from the event-loop thread) -------------------------------------\n+    @property\n+    def vocab_size(self) -> int:\n+        return self.engine.model_config.vocab_size\n+\n     @property\n     def is_running(self) -> bool:\n         return self._thread is not None and self._thread.is_alive()\n",
