# shwin-bench task image for emberserve. Build: docker build -f Dockerfile.emberserve --build-arg BASE_COMMIT=<sha> -t shwin/emberserve:<sha> .
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential && rm -rf /var/lib/apt/lists/*
# deps first so every task shares this layer
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir "safetensors>=0.4" "numpy>=1.26" "pytest>=8" "pytest-timeout>=2.3" "ruff>=0.5" "matplotlib>=3.8" "httpx>=0.27" \
    "fastapi>=0.110" "uvicorn[standard]>=0.29" "sse-starlette>=2.0" "openai>=1.30" "orjson>=3.9" \
    "transformers>=4.44" "huggingface_hub>=0.24" "accelerate>=0.33"
ARG BASE_COMMIT
RUN git clone https://github.com/ashwinsreedhar28/emberserve /testbed && cd /testbed && git checkout -q ${BASE_COMMIT} \
 && pip install --no-cache-dir --no-deps -e . && git config user.email agent@shwin && git config user.name agent
WORKDIR /testbed
ENV PYTEST_ADDOPTS='-m "not gpu and not hf"' PYTHONDONTWRITEBYTECODE=1 TOKENIZERS_PARALLELISM=false
